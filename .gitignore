__pycache__/
*.pyc
.venv/
.venv-vision/
.ipynb_checkpoints/

# build output -- anchored to the repo root ON PURPOSE.
# An unanchored `build/` also matches core/build/, which silently excludes
# core/build/netconvert.py, the most important module in the project.
/dist/
/build/
*.spec
# ...but the PyInstaller spec is BUILD INSTRUCTIONS, not build output. It was
# swept up by `*.spec` above and never committed, which is exactly how the
# shipping path was lost: `npm run tauri build` died on the missing sidecar and
# nothing in the repo said how to produce it. Keep it tracked.
!api_onefile.spec
apps/desktop/node_modules/
apps/desktop/src-tauri/target/
# Generated sidecar binary (~37 MB). Stays untracked on purpose -- it is
# reproducible with `python scripts/build_sidecar.py`.
apps/desktop/src-tauri/binaries/

# project runs -- regenerated by scripts/run_benchmark.py
projects/*
!projects/.gitkeep

# DO commit the cached benchmark assets. They are demo insurance:
# Overpass rate-limits and venue wifi fails.
!assets/benchmark/
!assets/benchmark/*.osm
!assets/benchmark/*.png

# never commit keys
.env
*.key
